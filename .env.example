# Copy this file to .env and set your own backend API key.
TEASER_PROVIDER=openai
OPENAI_API_KEY=
TEASER_TEXT_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
# Set VITE_API_BASE_URL when hosting the frontend separately from the backend.

# Shared deployment: configure these in Render, not in the frontend bundle.
CORS_ORIGINS=http://localhost:5173,https://luc4xz.github.io
# On Render, attach a persistent disk at /var/data before setting this:
# CHAT_HISTORY_DB_PATH=/var/data/chat_history.db
# Frontend build setting (GitHub repository variable):
# VITE_API_BASE_URL=https://teaser-generator-3qny.onrender.com

# Optional provider-specific models; only entries with a key (and Azure endpoint)
# are offered in the authenticated model menus. Use models your account can access.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_TEXT_MODEL=
AZURE_OPENAI_IMAGE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# Optional explicit allowlist replaces the provider defaults. Each model can use
# a different key_env, even within the same provider. See README for all providers.
# TEASER_MODELS_JSON='[{"id":"openai-fast","label":"GPT-5 nano","kind":"text","provider":"openai","model":"gpt-5-nano","key_env":"OPENAI_API_KEY"},{"id":"openai-general","label":"GPT-4o","kind":"text","provider":"openai","model":"gpt-4o","key_env":"OPENAI_API_KEY"},{"id":"image-mini","label":"GPT Image mini","kind":"image","provider":"openai","model":"gpt-image-1-mini","key_env":"OPENAI_API_KEY"},{"id":"image-standard","label":"GPT Image 1","kind":"image","provider":"openai","model":"gpt-image-1","key_env":"OPENAI_API_KEY"}]'
