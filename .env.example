# Copy this file to .env and set your own backend API key.
TEASER_PROVIDER=openai
OPENAI_API_KEY=
TEASER_TEXT_MODEL=gpt-5-nano
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
# Set VITE_API_BASE_URL when hosting the frontend separately from the backend.

# Shared deployment: configure these in Render, not in the frontend bundle.
CORS_ORIGINS=http://localhost:5173,https://luc4xz.github.io
# On Render, attach a persistent disk at /var/data before setting this:
# CHAT_HISTORY_DB_PATH=/var/data/chat_history.db
# Frontend build setting (GitHub repository variable):
# VITE_API_BASE_URL=https://teaser-generator-3qny.onrender.com
